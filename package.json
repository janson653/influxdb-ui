{
  "name": "influxdb-ui",
  "private": true,
  "version": "0.1.0",
  "description": "InfluxDB 1.x desktop client built with Electron",
  "author": "janson <zhangqian653@gmail.com>",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:compile:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "electron:start": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:1420 wait-on tcp:1420 file:dist-electron/main.js && electron dist-electron/main.js",
    "electron:dev": "concurrently -k \"pnpm electron:compile:watch\" \"pnpm dev\" \"pnpm electron:start\"",
    "electron:build": "pnpm build && pnpm electron:compile && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.influxdb-ui.app",
    "productName": "influxdb-ui",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "icon": "electron/assets/icons/icon.png",
    "linux": {
      "category": "Development",
      "icon": "electron/assets/icons"
    },
    "extraResources": [
      {
        "from": "electron/assets/icons",
        "to": "icons"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@monaco-editor/react": "^4.7.0",
    "antd": "^5.26.7",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "recharts": "^3.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "wait-on": "^9.0.4"
  }
}
