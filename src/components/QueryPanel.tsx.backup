import React, { useState, useEffect, useRef } from 'react';
import { 
  Tabs, 
  Button, 
  Select, 
  Input, 
  Table, 
  message, 
  Space, 
  Card,
  Row,
  Col,
  Badge,
  Tooltip,
  notification,
  Spin,
  List,
  Popover,
  Tag,
  Radio,
  Modal,
  Dropdown
} from 'antd';
import { 
  PlayCircleOutlined, 
  DatabaseOutlined, 
  TableOutlined, 
  DownloadOutlined,
  CodeOutlined,
  ClockCircleOutlined,
  InfoCircleOutlined,
  PlusOutlined,
  CloseOutlined,
  DownOutlined
} from '@ant-design/icons';

// 延迟加载Monaco Editor
let MonacoEditor: any = null;
const loadMonacoEditor = async () => {
  if (!MonacoEditor) {
    const module = await import('@monaco-editor/react');
    MonacoEditor = module.default;
  }
  return MonacoEditor;
};

import { influxDBService } from '../services/influxdb';
import { queryHistoryService } from '../services/queryHistory';
import { DataExportService } from '../services/dataExport';
import { QueryResult, InfluxDBConnection } from '../types/influxdb';
import Toolbar from './Toolbar';
import DataVisualization from './DataVisualization';
import './QueryPanel.css';

const { TextArea } = Input;
const { Option } = Select;

interface QueryPanelProps {
  currentConnection: InfluxDBConnection;
  onMeasurementSelect: (measurement: string) => void;
}

interface TabInfo {
  key: string;
  title: string;
  query: string;
  selectedDatabase: string;
  measurements: string[];
  queryResult: QueryResult | null;
  loading: boolean;
  executionTime?: number;
  rowCount?: number;
  error?: string;
}

const queryTemplates = [
  { label: 'SELECT 基础查询', value: 'SELECT * FROM "<measurement>" LIMIT 100' },
  { label: 'SELECT 指定字段', value: 'SELECT "field1", "field2" FROM "<measurement>" LIMIT 100' },
  { label: 'WHERE 条件', value: 'SELECT * FROM "<measurement>" WHERE "field" > 0 LIMIT 100' },
  { label: 'GROUP BY 时间', value: 'SELECT MEAN("field") FROM "<measurement>" WHERE time >= now() - 1h GROUP BY time(1m)' },
  { label: '聚合函数', value: 'SELECT COUNT("field"), MIN("field"), MAX("field") FROM "<measurement>" WHERE time >= now() - 1h' },
  { label: 'TAG 分组', value: 'SELECT * FROM "<measurement>" GROUP BY "tag1", "tag2"' },
];

const QueryPanel: React.FC<QueryPanelProps> = ({ currentConnection, onMeasurementSelect }) => {
  const [databases, setDatabases] = useState<string[]>([]);
  const [activeKey, setActiveKey] = useState('1');
  const [tabs, setTabs] = useState<TabInfo[]>([{
    key: '1',
    title: '查询 1',
    query: 'SELECT * FROM "cpu" LIMIT 100',
    selectedDatabase: '',
    measurements: [],
    queryResult: null,
    loading: false,
  }]);
  const [monacoLoaded, setMonacoLoaded] = useState(false);
  const [queryHistory, setQueryHistory] = useState<any[]>([]);
  const [showHistoryModal, setShowHistoryModal] = useState(false);
  const [searchKeyword, setSearchKeyword] = useState('');
  const [selectedTags, setSelectedTags] = useState<string[]>([]);
  const editorRefs = useRef<{[key: string]: any}>({});

  // 加载Monaco Editor
  useEffect(() => {
    const loadEditor = async () => {
      try {
        await loadMonacoEditor();
        setMonacoLoaded(true);
      } catch (error) {
        console.error('加载Monaco Editor失败:', error);
      }
    };
    loadEditor();
  }, []);

  // 加载查询历史
  useEffect(() => {
    const loadQueryHistory = async () => {
      try {
        const history = await queryHistoryService.getQueryHistory();
        setQueryHistory(history);
      } catch (error) {
        console.error('加载查询历史失败:', error);
      }
    };
    loadQueryHistory();
  }, []);

  // 配置Monaco Editor
  const configureEditor = (monaco: any) => {
    // 注册InfluxQL语言
    monaco.languages.register({ id: 'influxql' });
    
    // 定义InfluxQL关键字
    const keywords = [
      'SELECT', 'FROM', 'WHERE', 'GROUP', 'BY', 'ORDER', 'LIMIT', 'OFFSET', 'SLIMIT', 'SOFFSET',
      'INTO', 'DELETE', 'DROP', 'CREATE', 'SHOW', 'ALTER', 'SET', 'UNSET',
      'AND', 'OR', 'NOT', 'IN', 'LIKE', 'ILIKE',
      'ASC', 'DESC',
      'NOW', 'TIME', 'TZ'
    ];

    const functions = [
      'COUNT', 'DISTINCT', 'INTEGRAL', 'MEAN', 'MEDIAN', 'MODE', 'SPREAD', 'STDDEV', 'SUM',
      'BOTTOM', 'FIRST', 'LAST', 'MAX', 'MIN', 'PERCENTILE', 'SAMPLE', 'TOP',
      'CEILING', 'COS', 'CUMULATIVE_SUM', 'DERIVATIVE', 'DIFFERENCE', 'ELAPSED',
      'FLOOR', 'HISTOGRAM', 'MOVING_AVERAGE', 'NON_NEGATIVE_DERIVATIVE', 'NON_NEGATIVE_DIFFERENCE',
      'RATE', 'SIN', 'SQRT', 'TAN'
    ];

    const types = [
      'BOOLEAN', 'DURATION', 'FLOAT', 'INTEGER', 'STRING', 'TIME'
    ];

    // 注册语法高亮
    monaco.languages.setMonarchTokensProvider('influxql', {
      tokenizer: {
        root: [
          [/SELECT|FROM|WHERE|GROUP|BY|ORDER|LIMIT|OFFSET|INTO|DELETE|DROP|CREATE|SHOW|ALTER|SET|UNSET|AND|OR|NOT|IN|LIKE|ILIKE|ASC|DESC|NOW|TIME|TZ/, 'keyword'],
          [/COUNT|DISTINCT|INTEGRAL|MEAN|MEDIAN|MODE|SPREAD|STDDEV|SUM|BOTTOM|FIRST|LAST|MAX|MIN|PERCENTILE|SAMPLE|TOP|CEILING|COS|CUMULATIVE_SUM|DERIVATIVE|DIFFERENCE|ELAPSED|FLOOR|HISTOGRAM|MOVING_AVERAGE|NON_NEGATIVE_DERIVATIVE|NON_NEGATIVE_DIFFERENCE|RATE|SIN|SQRT|TAN/, 'function'],
          [/BOOLEAN|DURATION|FLOAT|INTEGER|STRING|TIME/, 'type'],
          [/"[^"]*"/, 'string'],
          [/'[^']*'/, 'string'],
          [/[0-9]+(\.[0-9]+)?/, 'number'],
          [/--.*$/, 'comment'],
          [/\/\*[\s\S]*?\*\//, 'comment'],
          [/[;,.]/, 'delimiter'],
          [/[+\-*/%=<>!&|^~]/, 'operator'],
          [/\w+/, 'identifier']
        ]
      }
    });

    // 注册自动补全
    monaco.languages.registerCompletionItemProvider('influxql', {
      provideCompletionItems: (model: any, position: any) => {
        const word = model.getWordUntilPosition(position);
        const range = {
          startLineNumber: position.lineNumber,
          endLineNumber: position.lineNumber,
          startColumn: word.startColumn,
          endColumn: word.endColumn
        };

        const suggestions = [
          ...keywords.map(keyword => ({
            label: keyword,
            kind: monaco.languages.CompletionItemKind.Keyword,
            insertText: keyword,
            range: range
          })),
          ...functions.map(func => ({
            label: func,
            kind: monaco.languages.CompletionItemKind.Function,
            insertText: func,
            range: range
          })),
          ...types.map(type => ({
            label: type,
            kind: monaco.languages.CompletionItemKind.TypeParameter,
            insertText: type,
            range: range
          }))
        ];

        // 添加measurement建议
        const currentTab = tabs.find(t => t.key === activeKey);
        if (currentTab && currentTab.measurements.length > 0) {
          suggestions.push(...currentTab.measurements.map(measurement => ({
            label: measurement,
            kind: monaco.languages.CompletionItemKind.Class,
            insertText: `"${measurement}"`,
            range: range
          })));
        }

        return { suggestions };
      }
    });
  };

  // 编辑器内容变化处理
  const handleEditorChange = (value: string | undefined, tabKey: string) => {
    if (value !== undefined) {
      updateTabState(tabKey, { query: value });
    }
  };

  // 编辑器挂载处理
  const handleEditorDidMount = (editor: any, monaco: any, tabKey: string) => {
    editorRefs.current[tabKey] = editor;
    
    // 配置快捷键
    editor.addCommand(monaco.KeyMod.CtrlCmd | monaco.KeyCode.Enter, () => {
      executeQuery(tabKey);
    });

    // 配置编辑器选项
    editor.updateOptions({
      minimap: { enabled: false },
      scrollBeyondLastLine: false,
      fontSize: 14,
      lineHeight: 1.6,
      fontFamily: 'Monaco, Menlo, Ubuntu Mono, monospace',
      wordWrap: 'on',
      lineNumbers: 'on',
      renderLineHighlight: 'all',
      selectOnLineNumbers: true,
      matchBrackets: 'always',
      autoIndent: 'advanced',
      formatOnPaste: true,
      formatOnType: true
    });

  // 查询历史管理函数
  const saveQueryToHistory = async (query: string, database: string) => {
    if (!query.trim() || !currentConnection) return;
    
    try {
      await queryHistoryService.saveQueryHistory({
        title: `查询 - ${new Date().toLocaleString()}`,
        query: query.trim(),
        database: database,
        connectionId: currentConnection.id,
        tags: ['手动保存'],
        description: `在 ${new Date().toLocaleString()} 手动保存的查询`
      });
      
      // 重新加载查询历史
      const history = await queryHistoryService.getQueryHistory();
      setQueryHistory(history);
      
      message.success('查询已保存到历史记录');
    } catch (error) {
      console.error('保存查询历史失败:', error);
      message.error('保存查询历史失败');
    }
  };

  const loadQueryFromHistory = (historyItem: any) => {
    // 加载查询到当前标签页
    updateTabState(activeKey, { 
      query: historyItem.query,
      selectedDatabase: historyItem.database
    });
    
    // 如果有数据库，加载测量列表
    if (historyItem.database) {
      loadMeasurementsForTab(activeKey, historyItem.database);
    }
    
    setShowHistoryModal(false);
    message.success('已加载历史查询');
  };

  const deleteQueryFromHistory = async (id: string) => {
    try {
      await queryHistoryService.deleteQueryHistory(id);
      const history = await queryHistoryService.getQueryHistory();
      setQueryHistory(history);
      message.success('查询历史已删除');
    } catch (error) {
      console.error('删除查询历史失败:', error);
      message.error('删除查询历史失败');
    }
  };

  const searchQueryHistory = async () => {
    try {
      const results = await queryHistoryService.searchQueryHistory({
        keyword: searchKeyword,
        tags: selectedTags.length > 0 ? selectedTags : undefined,
        connectionId: currentConnection?.id,
        limit: 50
      });
      setQueryHistory(results);
    } catch (error) {
      console.error('搜索查询历史失败:', error);
      message.error('搜索查询历史失败');
    }
  };

  const clearSearch = async () => {
    setSearchKeyword('');
    setSelectedTags([]);
    const history = await queryHistoryService.getQueryHistory();
    setQueryHistory(history);
  };

  // 加载数据库列表
  useEffect(() => {
    const fetchDatabases = async () => {
      if (!currentConnection) {
        console.log('⚠️ 没有当前连接，跳过数据库列表加载');
        return;
      }
      
      console.group('📊 加载数据库列表');
      console.log('当前连接:', currentConnection.name);
      
      try {
        console.log('步骤 1: 建立连接');
        await influxDBService.connect(currentConnection);
        
        console.log('步骤 2: 获取数据库列表');
        const dbList = await influxDBService.getDatabases();
        console.log('获取到数据库列表:', dbList);
        
        setDatabases(dbList);
        
        // 如果只有一个数据库，自动选中
        if (dbList.length === 1) {
          console.log('只有一个数据库，自动选中:', dbList[0]);
          const updatedTab = {
            ...tabs[0],
            selectedDatabase: dbList[0],
          };
          setTabs([updatedTab]);
          // 自动加载测量列表
          await loadMeasurementsForTab(tabs[0].key, dbList[0]);
        }
        
        console.log('✅ 数据库列表加载完成');
        console.groupEnd();
      } catch (error) {
        console.error('❌ 获取数据库列表失败:', error);
        console.error('错误详情:', {
          message: error instanceof Error ? error.message : '未知错误',
          stack: error instanceof Error ? error.stack : undefined,
          name: error instanceof Error ? error.name : undefined
        });
        
        message.error('获取数据库列表失败');
        notification.error({
          message: '连接错误',
          description: `无法连接到数据库服务器，请检查连接配置。错误: ${error instanceof Error ? error.message : '未知错误'}`
        });
        console.groupEnd();
      }
    };
    fetchDatabases();
  }, [currentConnection]);

  const handleTabChange = (key: string) => {
    setActiveKey(key);
  };

  const addTab = () => {
    const newKey = `query-${tabs.length + 1}`;
    setTabs([...tabs, {
      key: newKey,
      title: `查询 ${tabs.length + 1}`,
      query: '',
      selectedDatabase: '',
      measurements: [],
      queryResult: null,
      loading: false,
    }]);
    setActiveKey(newKey);
  };

  const removeTab = (targetKey: string) => {
    let newActiveKey = activeKey;
    let lastIndex = -1;
    tabs.forEach((tab, i) => {
      if (tab.key === targetKey) {
        lastIndex = i - 1;
      }
    });
    const newTabs = tabs.filter(tab => tab.key !== targetKey);
    if (newTabs.length && newActiveKey === targetKey) {
      newActiveKey = newTabs[lastIndex >= 0 ? lastIndex : 0].key;
    }
    setTabs(newTabs);
    setActiveKey(newActiveKey);
  };

  const updateTabState = (key: string, newState: Partial<TabInfo>) => {
    setTabs(tabs.map(tab => 
      tab.key === key ? { ...tab, ...newState } : tab
    ));
  };

  // 结果标签页状态
  const [activeResultTab, setActiveResultTab] = useState<'results' | 'chart' | 'messages'>('results');
  
  // 查询日志状态
  const [queryLogs, setQueryLogs] = useState<Array<{
    timestamp: string;
    level: 'info' | 'error' | 'success';
    message: string;
  }>>([]);

  const executeQuery = async (tabKey: string) => {
    const tab = tabs.find(t => t.key === tabKey);
    if (!tab || !tab.selectedDatabase) {
      console.log('❌ 未选择数据库');
      message.error('请先选择数据库');
      return;
    }

    if (!tab.query.trim()) {
      console.log('❌ 查询语句为空');
      message.error('请输入查询语句');
      return;
    }

    // 添加查询开始日志
    const startLog = {
      timestamp: new Date().toLocaleTimeString(),
      level: 'info' as const,
      message: `开始执行查询: ${tab.query.substring(0, 100)}...`
    };
    setQueryLogs(prev => [...prev, startLog]);

    console.group('🔍 执行查询');
    console.log('查询标签:', tabKey);
    console.log('数据库:', tab.selectedDatabase);
    console.log('查询语句:', tab.query);

    const startTime = Date.now();
    updateTabState(tabKey, { loading: true, error: undefined });

    try {
      console.log('发送查询请求...');
      const result = await influxDBService.executeQuery(tab.query, tab.selectedDatabase);
      const executionTime = Date.now() - startTime;
      
      console.log('查询响应:', result);
      
      const rowCount = result.series?.reduce((count, series) => 
        count + (series.values?.length || 0), 0) || 0;
      
      console.log('查询统计:', {
        executionTime: `${executionTime}ms`,
        rowCount,
        seriesCount: result.series?.length || 0,
        hasError: !!result.error
      });

      updateTabState(tabKey, { 
        queryResult: result,
        loading: false,
        executionTime,
        rowCount,
        error: result.error
      });

      // 添加查询成功日志
      const successLog = {
        timestamp: new Date().toLocaleTimeString(),
        level: 'success' as const,
        message: `查询执行成功 - 执行时间: ${executionTime}ms, 返回 ${rowCount} 条记录`
      };
      setQueryLogs(prev => [...prev, successLog]);

      if (result.error) {
        console.error('❌ 查询返回错误:', result.error);
        notification.error({
          message: '查询执行失败',
          description: result.error
        });
        
        // 添加错误日志
        const errorLog = {
          timestamp: new Date().toLocaleTimeString(),
          level: 'error' as const,
          message: `查询错误: ${result.error}`
        };
        setQueryLogs(prev => [...prev, errorLog]);
      } else {
        console.log('✅ 查询执行成功');
        notification.success({
          message: '查询执行成功',
          description: `执行时间: ${executionTime}ms, 返回 ${rowCount} 条记录`
        });
        
        // 自动保存到查询历史
        if (currentConnection) {
          try {
            await queryHistoryService.saveQueryHistory({
              title: `${tab.query.substring(0, 50)}...`,
              query: tab.query,
              database: tab.selectedDatabase,
              connectionId: currentConnection.id,
              tags: ['自动保存'],
              executionTime: executionTime,
              resultCount: rowCount,
              description: `自动保存的查询执行记录`
            });
            
            // 重新加载查询历史
            const history = await queryHistoryService.getQueryHistory();
            setQueryHistory(history);
          } catch (error) {
            console.warn('自动保存查询历史失败:', error);
            // 不显示错误，避免干扰用户
          }
        }
      }
      console.groupEnd();
    } catch (error) {
      console.error('❌ 查询执行异常:', error);
      console.error('错误详情:', {
        message: error instanceof Error ? error.message : '未知错误',
        stack: error instanceof Error ? error.stack : undefined,
        name: error instanceof Error ? error.name : undefined
      });
      
      updateTabState(tabKey, { 
        loading: false,
        error: error instanceof Error ? error.message : '查询执行失败'
      });
      
      // 添加异常日志
      const exceptionLog = {
        timestamp: new Date().toLocaleTimeString(),
        level: 'error' as const,
        message: `查询异常: ${error instanceof Error ? error.message : '未知错误'}`
      };
      setQueryLogs(prev => [...prev, exceptionLog]);
      
      notification.error({
        message: '查询执行失败',
        description: error instanceof Error ? error.message : '未知错误'
      });
      console.groupEnd();
    }
  };

  const exportQueryResult = async (tabKey: string, format: 'csv' | 'json' | 'excel' = 'csv') => {
    const tab = tabs.find(t => t.key === tabKey);
    if (!tab || !tab.queryResult || tab.queryResult.error) {
      message.error('没有可导出的查询结果');
      return;
    }

    try {
      const data = getTableData(tab.queryResult);
      
      // 检查数据是否为空
      if (data.data.length === 0) {
        message.warning('查询结果为空，无法导出');
        return;
      }

      // 准备导出数据
      const exportData = {
        columns: data.columns.map(col => ({
          title: col.title,
          dataIndex: col.dataIndex,
          type: col.dataIndex === 'time' ? 'date' : 
                typeof data.data[0]?.[col.dataIndex] === 'number' ? 'number' : 'string'
        })),
        data: data.data
      };

      // 生成文件名
      const timestamp = new Date().toISOString().replace(/[:.]/g, '-').split('T')[0];
      const filename = `influxdb_query_${tab.selectedDatabase}_${timestamp}`;

      // 执行导出
      await DataExportService.exportData(exportData, {
        format,
        filename,
        sheetName: 'Query Results',
        includeHeader: true,
        dateColumns: ['time']
      });

      message.success(`数据已成功导出为 ${format.toUpperCase()} 格式`);
    } catch (error) {
      console.error('导出失败:', error);
      message.error(`导出失败: ${error instanceof Error ? error.message : '未知错误'}`);
    }
  };

  const insertTemplate = (template: string) => {
    setTabs(tabs.map(tab => 
      tab.key === activeKey ? { ...tab, query: template } : tab
    ));
  };

  // 加载测量列表 - 在数据库选择变化时加载
  const loadMeasurementsForTab = async (tabKey: string, database: string) => {
    if (!database) return;
    try {
      const measurementList = await influxDBService.getMeasurements(database);
      updateTabState(tabKey, { measurements: measurementList });
    } catch (error) {
      // 静默失败，不显示错误
    }
  };

  // 工具栏事件处理
  const handleNewConnection = () => {
    // 这个事件会传递给父组件处理
    window.dispatchEvent(new CustomEvent('newConnection'));
  };

  const handleSaveQuery = () => {
    const tab = tabs.find(t => t.key === activeKey);
    if (tab && tab.query.trim() && tab.selectedDatabase) {
      saveQueryToHistory(tab.query, tab.selectedDatabase);
    } else {
      message.warning('请先选择数据库并输入查询语句');
    }
  };

  const handleOpenQuery = () => {
    setShowHistoryModal(true);
  };

  const handleRefreshResults = () => {
    const tab = tabs.find(t => t.key === activeKey);
    if (tab && tab.query.trim() && tab.selectedDatabase) {
      executeQuery(tab.key);
    }
  };

  const handleExportResults = () => {
    const tab = tabs.find(t => t.key === activeKey);
    if (!tab || !tab.queryResult || tab.queryResult.error) {
      message.error('没有可导出的查询结果');
      return;
    }

    // 显示导出格式选择菜单
    Modal.confirm({
      title: '选择导出格式',
      content: (
        <div>
          <p>请选择要导出的文件格式：</p>
          <div style={{ marginTop: 16 }}>
            <Radio.Group defaultValue="csv">
              <Space direction="vertical">
                <Radio value="csv">
                  <div>
                    <strong>CSV 格式</strong>
                    <div style={{ fontSize: 12, color: '#666' }}>
                      通用格式，兼容Excel和其他数据分析工具
                    </div>
                  </div>
                </Radio>
                <Radio value="json">
                  <div>
                    <strong>JSON 格式</strong>
                    <div style={{ fontSize: 12, color: '#666' }}>
                      包含完整数据结构和元数据信息
                    </div>
                  </div>
                </Radio>
                <Radio value="excel">
                  <div>
                    <strong>Excel 格式</strong>
                    <div style={{ fontSize: 12, color: '#666' }}>
                      原生Excel文件，保留格式和类型信息
                    </div>
                  </div>
                </Radio>
              </Space>
            </Radio.Group>
          </div>
        </div>
      ),
      okText: '导出',
      cancelText: '取消',
      onOk: () => {
        const radioValue = (document.querySelector('input[name="radioGroup"]:checked') as HTMLInputElement)?.value;
        const format = radioValue || 'csv';
        exportQueryResult(activeKey, format as 'csv' | 'json' | 'excel');
      }
    });
  };

  const handleExecuteQuery = () => {
    executeQuery(activeKey);
  };

  // 获取当前标签页
  const currentTab = tabs.find(t => t.key === activeKey);
  const canSaveQuery = currentTab?.query.trim() || false;
  const canExecuteQuery = currentTab?.query.trim() && currentTab?.selectedDatabase || false;
  const canExportResults = currentTab?.queryResult && !currentTab.queryResult?.error || false;
  const canRefreshResults = currentTab?.query.trim() && currentTab?.selectedDatabase || false;
  const isLoading = currentTab?.loading || false;

  const getTableData = (queryResult: QueryResult | null) => {
    if (!queryResult?.series || queryResult.series.length === 0) {
      return { columns: [], data: [] };
    }

    let allColumns = new Set<string>();
    let allData: any[] = [];
    let rowIndex = 0;

    queryResult.series.forEach(series => {
      series.columns.forEach(col => allColumns.add(col));
      
      series.values.forEach(value => {
        const row: any = { 
          key: rowIndex++, 
          __series_name: series.name,
          __tags: series.tags || {}
        };
        series.columns.forEach((col, index) => {
          row[col] = value[index];
        });
        allData.push(row);
      });
    });

    const columns = Array.from(allColumns).map(col => ({
      title: col,
      dataIndex: col,
      key: col,
      ellipsis: {
        showTitle: true,
      },
      width: 150,
      render: (text: any) => {
        if (text === null || text === undefined) return '-';
        if (typeof text === 'number') return text.toLocaleString();
        if (typeof text === 'string' && text.length > 50) {
          return (
            <Tooltip title={text}>
              <span>{text.slice(0, 47)}...</span>
            </Tooltip>
          );
        }
        return String(text);
      }
    }));

    // 添加时间格式化
    if (columns.some(col => col.dataIndex === 'time')) {
      const timeCol = columns.find(col => col.dataIndex === 'time');
      if (timeCol) {
        timeCol.render = (text: any) => {
          if (!text) return '-';
          try {
            const date = new Date(text);
            return date.toLocaleString();
          } catch {
            return text;
          }
        };
        timeCol.width = 200;
      }
    }

    return { columns, data: allData };
  };

  // 生成 Tab items
  const tabItems = tabs.map(tab => {
    const { columns, data } = getTableData(tab.queryResult);
    return {
      key: tab.key,
      label: (
        <span className="tab-label">
          {tab.title}
          {tab.loading && <Spin size="small" style={{ marginLeft: 8 }} />}
          {tab.error && <Tag color="error" size="small" style={{ marginLeft: 8 }}>错误</Tag>}
        </span>
      ),
      closable: tabs.length > 1,
      children: (
        <div className="query-panel-tab-content">
          {/* 工具栏 */}
          <Toolbar
            onNewConnection={handleNewConnection}
            onSaveQuery={handleSaveQuery}
            onExecuteQuery={handleExecuteQuery}
            onExportResults={handleExportResults}
            onRefreshResults={handleRefreshResults}
            onOpenQuery={handleOpenQuery}
            canSaveQuery={canSaveQuery}
            canExecuteQuery={canExecuteQuery}
            canExportResults={canExportResults}
            canRefreshResults={canRefreshResults}
            loading={isLoading}
          />

          {/* 查询编辑器 */}
          <div className="query-editor-section">
            <Row gutter={16}>
              <Col span={18}>
                <Space direction="vertical" style={{ width: '100%' }}>
                  <Space>
                    <Select
                      placeholder="选择数据库"
                      value={tab.selectedDatabase}
                      onChange={async (value) => {
                        updateTabState(tab.key, { selectedDatabase: value });
                        await loadMeasurementsForTab(tab.key, value);
                      }}
                      style={{ minWidth: 120 }}
                      loading={!databases.length}
                    >
                      {databases.map(db => (
                        <Option key={db} value={db}>
                          <DatabaseOutlined /> {db}
                        </Option>
                      ))}
                    </Select>
                    <Select
                      placeholder="选择表/测量值"
                      style={{ minWidth: 120 }}
                      onSelect={(value: string) => {
                        // 替换当前查询中的表名
                        const newQuery = tab.query.replace(/FROM\s+\"([^\"]+)\"/, `FROM \"${value}\"`);
                        updateTabState(tab.key, { query: newQuery });
                        onMeasurementSelect(value);
                      }}
                      disabled={!tab.selectedDatabase}
                    >
                      {tab.measurements.map(m => (
                        <Option key={m} value={m}>
                          <TableOutlined /> {m}
                        </Option>
                      ))}
                    </Select>
                  </Space>

                  {/* 查询编辑器 */}
                  <div className="query-editor-container">
                    {monacoLoaded && MonacoEditor ? (
                      <MonacoEditor
                        height="200px"
                        language="influxql"
                        value={tab.query}
                        onChange={(value: string | undefined) => handleEditorChange(value, tab.key)}
                        onMount={(editor: any, monaco: any) => handleEditorDidMount(editor, monaco, tab.key)}
                        beforeMount={configureEditor}
                        options={{
                          minimap: { enabled: false },
                          scrollBeyondLastLine: false,
                          fontSize: 14,
                          lineHeight: 1.6,
                          fontFamily: 'Monaco, Menlo, Ubuntu Mono, monospace',
                          wordWrap: 'on',
                          lineNumbers: 'on',
                          renderLineHighlight: 'all',
                          selectOnLineNumbers: true,
                          matchBrackets: 'always',
                          autoIndent: 'advanced',
                          formatOnPaste: true,
                          formatOnType: true,
                          automaticLayout: true,
                          theme: 'vs-light'
                        }}
                      />
                    ) : (
                      <TextArea
                        value={tab.query}
                        onChange={(e) => updateTabState(tab.key, { query: e.target.value })}
                        placeholder="输入 InfluxQL 查询语句 (按 Ctrl+Enter 执行)..."
                        rows={8}
                        className="query-textarea"
                        onKeyDown={(e) => {
                          if (e.ctrlKey && e.key === 'Enter') {
                            executeQuery(tab.key);
                          }
                        }}
                      />
                    )}
                  </div>

                  <Space>
                    <Button
                      type="primary"
                      icon={<PlayCircleOutlined />}
                      onClick={() => executeQuery(tab.key)}
                      loading={tab.loading}
                    >
                      执行查询
                    </Button>
                    <Dropdown
                      menu={{
                        items: [
                          {
                            key: 'csv',
                            label: '导出为 CSV',
                            icon: <DownloadOutlined />,
                            onClick: () => exportQueryResult(tab.key, 'csv')
                          },
                          {
                            key: 'json',
                            label: '导出为 JSON',
                            icon: <DownloadOutlined />,
                            onClick: () => exportQueryResult(tab.key, 'json')
                          },
                          {
                            key: 'excel',
                            label: '导出为 Excel',
                            icon: <DownloadOutlined />,
                            onClick: () => exportQueryResult(tab.key, 'excel')
                          }
                        ]
                      }}
                      disabled={!tab.queryResult || !!tab.queryResult.error}
                    >
                      <Button icon={<DownloadOutlined />}>
                        导出 <DownOutlined />
                      </Button>
                    </Dropdown>
                    <Popover
                      content={
                        <Card
                          title="查询模板"
                          size="small"
                          bodyStyle={{ padding: 8 }}
                        >
                          <List
                            size="small"
                            dataSource={queryTemplates}
                            renderItem={template => (
                              <List.Item
                                className="query-template-item"
                                onClick={() => insertTemplate(template.value)}
                              >
                                <Space>
                                  <CodeOutlined />
                                  <span style={{ whiteSpace: 'nowrap' }}>
                                    {template.label}
                                  </span>
                                </Space>
                              </List.Item>
                            )}
                          />
                        </Card>
                      }
                      title="选择查询模板"
                      trigger="click"
                    >
                      <Button icon={<CodeOutlined />} size="small">
                        模板
                      </Button>
                    </Popover>
                  </Space>
                </Space>
              </Col>
              <Col span={6}>
                <Space direction="vertical" style={{ width: '100%' }}>
                  <Card size="small" title="查询信息">
                    <Space direction="vertical" style={{ width: '100%' }}>
                      <Space>
                        <ClockCircleOutlined />
                        <span>执行时间: {tab.executionTime || 0}ms</span>
                      </Space>
                      <div>
                        <Badge 
                          status={tab.rowCount ? "success" : "default"} 
                          text={`返回行数: ${tab.rowCount || 0}`} 
                        />
                      </div>
                    </Space>
                  </Card>
                </Space>
              </Col>
            </Row>
          </div>

          {/* 结果展示 */}
          <div className="results-section">
            {/* 结果标签页 */}
            <div className="result-tabs">
              <div 
                className={`result-tab ${activeResultTab === 'results' ? 'active' : ''}`}
                onClick={() => setActiveResultTab('results')}
              >
                结果
              </div>
              <div 
                className={`result-tab ${activeResultTab === 'chart' ? 'active' : ''}`}
                onClick={() => setActiveResultTab('chart')}
              >
                图表
              </div>
              <div 
                className={`result-tab ${activeResultTab === 'messages' ? 'active' : ''}`}
                onClick={() => setActiveResultTab('messages')}
              >
                消息
              </div>
            </div>

            {/* 结果内容 */}
            <div className="result-content">
              {activeResultTab === 'results' ? (
                <div className="results-tab-content">
                  {tab.loading && (
                    <div style={{ textAlign: 'center', padding: 50 }}>
                      <Spin size="large" tip="正在执行查询..." />
                    </div>
                  )}

                  {tab.queryResult && (
                    <div>
                      {tab.error ? (
                        <Card 
                          bodyStyle={{ 
                            backgroundColor: '#fff2f0', 
                            borderColor: '#ffccc7',
                            color: '#a8071a'
                          }}
                        >
                          <Space>
                            <InfoCircleOutlined />
                            <span>{tab.error}</span>
                          </Space>
                        </Card>
                      ) : (
                        <Card 
                          size="small"
                          title={`查询结果 - ${columns.length} 列  ${data.length} 行`}
                          extra={
                            <Space>
                              <Dropdown
                                menu={{
                                  items: [
                                    {
                                      key: 'csv',
                                      label: '导出为 CSV',
                                      icon: <DownloadOutlined />,
                                      onClick: () => exportQueryResult(tab.key, 'csv')
                                    },
                                    {
                                      key: 'json',
                                      label: '导出为 JSON',
                                      icon: <DownloadOutlined />,
                                      onClick: () => exportQueryResult(tab.key, 'json')
                                    },
                                    {
                                      key: 'excel',
                                      label: '导出为 Excel',
                                      icon: <DownloadOutlined />,
                                      onClick: () => exportQueryResult(tab.key, 'excel')
                                    }
                                  ]
                                }}
                              >
                                <Button size="small" icon={<DownloadOutlined />}>
                                  导出 <DownOutlined />
                                </Button>
                              </Dropdown>
                            </Space>
                          }
                        >
                          <Table
                            columns={columns}
                            dataSource={data}
                            scroll={{ x: 'max-content', y: 400 }}
                            pagination={{ 
                              pageSize: 100, 
                              showSizeChanger: true, 
                              showQuickJumper: true,
                              showTotal: (total, range) => 
                                `${range[0]}-${range[1]} / ${total} 条记录`
                            }}
                            size="small"
                            sticky
                          />
                        </Card>
                      )}
                    </div>
                  )}
                </div>
              ) : activeResultTab === 'chart' ? (
                <div className="chart-tab-content">
                  {tab.loading && (
                    <div style={{ textAlign: 'center', padding: 50 }}>
                      <Spin size="large" tip="正在执行查询..." />
                    </div>
                  )}

                  {tab.queryResult ? (
                    <div>
                      {tab.error ? (
                        <Card 
                          bodyStyle={{ 
                            backgroundColor: '#fff2f0', 
                            borderColor: '#ffccc7',
                            color: '#a8071a'
                          }}
                        >
                          <Space>
                            <InfoCircleOutlined />
                            <span>{tab.error}</span>
                          </Space>
                        </Card>
                      ) : (
                        <DataVisualization
                          queryResult={tab.queryResult}
                          query={tab.query}
                          database={tab.selectedDatabase}
                          onExport={(format) => {
                            message.info(`图表导出为 ${format.toUpperCase()} 格式功能开发中`);
                          }}
                        />
                      )}
                    </div>
                  ) : (
                    <div style={{ 
                      textAlign: 'center', 
                      padding: '60px 20px',
                      color: '#999'
                    }}>
                      <InfoCircleOutlined style={{ fontSize: 48, marginBottom: 16 }} />
                      <p>请先执行查询以生成图表</p>
                      <p style={{ fontSize: 12, marginTop: 8 }}>
                        执行查询后将自动分析数据并生成可视化图表
                      </p>
                    </div>
                  )}
                </div>
              ) : (
                <div className="messages-tab-content">
                  <Card 
                    size="small"
                    title="查询日志"
                    extra={
                      <Button 
                        size="small" 
                        onClick={() => setQueryLogs([])}
                        disabled={queryLogs.length === 0}
                      >
                        清空日志
                      </Button>
                    }
                  >
                    <div className="query-logs">
                      {queryLogs.length === 0 ? (
                        <div className="empty-logs">
                          <p>暂无查询日志</p>
                          <p className="hint">执行查询后将显示详细日志信息</p>
                        </div>
                      ) : (
                        <List
                          size="small"
                          dataSource={queryLogs}
                          renderItem={(log, index) => (
                            <List.Item className={`log-item log-${log.level}`}>
                              <div className="log-content">
                                <div className="log-header">
                                  <span className="log-timestamp">{log.timestamp}</span>
                                  <Tag 
                                    size="small" 
                                    color={
                                      log.level === 'success' ? 'green' : 
                                      log.level === 'error' ? 'red' : 'blue'
                                    }
                                  >
                                    {log.level === 'info' ? '信息' : 
                                     log.level === 'error' ? '错误' : '成功'}
                                  </Tag>
                                </div>
                                <div className="log-message">{log.message}</div>
                              </div>
                            </List.Item>
                          )}
                        />
                      )}
                    </div>
                  </Card>
                </div>
              )}
            </div>
          </div>
        </div>
      )
    };
  });

  return (
    <div className="query-panel-container">
      <Tabs
        type="editable-card"
        onChange={handleTabChange}
        activeKey={activeKey}
        onEdit={(targetKey, action) => 
          action === 'add' ? addTab() : removeTab(targetKey as string)
        }
        items={tabItems}
        className="query-panel-tabs"
        addIcon={<PlusOutlined />}
      />

      {/* 查询历史模态框 */}
      <Modal
        title="查询历史记录"
        open={showHistoryModal}
        onCancel={() => setShowHistoryModal(false)}
        footer={null}
        width={800}
        destroyOnClose
      >
        {/* 搜索栏 */}
        <div className="query-history-search">
          <Row gutter={16}>
            <Col span={12}>
              <Input.Search
                placeholder="搜索查询语句..."
                value={searchKeyword}
                onChange={(e) => setSearchKeyword(e.target.value)}
                onSearch={searchQueryHistory}
                allowClear
              />
            </Col>
            <Col span={8}>
              <Space>
                <Button onClick={clearSearch}>清空</Button>
                <Button type="primary" onClick={searchQueryHistory}>搜索</Button>
              </Space>
            </Col>
            <Col span={4}>
              <Button 
                danger 
                onClick={() => {
                  Modal.confirm({
                    title: '确认清空',
                    content: '确定要清空所有查询历史记录吗？此操作不可恢复。',
                    onOk: async () => {
                      try {
                        await queryHistoryService.clearQueryHistory();
                        setQueryHistory([]);
                        message.success('查询历史已清空');
                      } catch (error) {
                        message.error('清空查询历史失败');
                      }
                    }
                  });
                }}
              >
                清空历史
              </Button>
            </Col>
          </Row>
        </div>

        {/* 查询历史列表 */}
        <div className="query-history-list">
          {queryHistory.length === 0 ? (
            <div className="empty-history">
              <InfoCircleOutlined style={{ fontSize: 48, color: '#d9d9d9' }} />
              <p>暂无查询历史记录</p>
              <p className="hint">执行查询后会自动保存到历史记录中</p>
            </div>
          ) : (
            <List
              dataSource={queryHistory}
              renderItem={(item) => (
                <List.Item
                  key={item.id}
                  actions={[
                    <Button
                      key="load"
                      type="primary"
                      size="small"
                      onClick={() => loadQueryFromHistory(item)}
                    >
                      加载
                    </Button>,
                    <Button
                      key="delete"
                      danger
                      size="small"
                      onClick={() => {
                        Modal.confirm({
                          title: '确认删除',
                          content: '确定要删除这条查询历史记录吗？',
                          onOk: () => deleteQueryFromHistory(item.id)
                        });
                      }}
                    >
                      删除
                    </Button>
                  ]}
                >
                  <List.Item.Meta
                    title={
                      <Space>
                        <Text strong>{item.title}</Text>
                        {item.isFavorite && <Tag color="gold">★ 收藏</Tag>}
                        {item.tags.map((tag: string) => (
                          <Tag key={tag} color="blue">{tag}</Tag>
                        ))}
                      </Space>
                    }
                    description={
                      <div>
                        <div className="query-preview">
                          <Text code>{item.query}</Text>
                        </div>
                        <div className="query-meta">
                          <Space>
                            <Text type="secondary">数据库: {item.database}</Text>
                            <Text type="secondary">执行次数: {item.executionCount}</Text>
                            {item.executionTime && (
                              <Text type="secondary">执行时间: {item.executionTime}ms</Text>
                            )}
                            {item.resultCount !== undefined && (
                              <Text type="secondary">结果数: {item.resultCount}</Text>
                            )}
                            <Text type="secondary">最后使用: {new Date(item.lastUsed).toLocaleString()}</Text>
                          </Space>
                        </div>
                      </div>
                    }
                  />
                </List.Item>
              )}
            />
          )}
        </div>
      </Modal>
    </div>
  );
};

export default QueryPanel;